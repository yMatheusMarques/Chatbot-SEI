# ---------------------------------------------------------------
# Variáveis de ambiente do backend do assistente SEI Alagoas
# ---------------------------------------------------------------
# Copie este arquivo para ".env" e ajuste os valores conforme o
# seu ambiente. O arquivo ".env" NUNCA deve ser commitado no Git
# nem exposto publicamente, pois é onde ficam segredos como
# chaves de API.
# ---------------------------------------------------------------

# Porta em que o backend vai escutar
PORT=3000

# Provedor do modelo de linguagem: "ollama" (local, padrão) ou "anthropic"
LLM_PROVIDER=ollama

# --- Configuração do Ollama (usado quando LLM_PROVIDER=ollama) ---
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.1:8b

# --- Configuração da Anthropic (usado quando LLM_PROVIDER=anthropic) ---
# Necessário apenas se você decidir usar a API da Anthropic no futuro.
# Gere sua chave em https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Origem(ns) permitida(s) para acessar este backend (CORS).
# Em produção, troque "*" pelo domínio real do site, por exemplo:
#   ALLOWED_ORIGIN=https://chatbot.al.gov.br
ALLOWED_ORIGIN=*
